# ── DATABASE ─────────────────────────────────────────────────────────────────
# SQLite (development) or PostgreSQL (production)
DATABASE_URL=sqlite:///./rhythmai.db

# ── AUTHENTICATION ────────────────────────────────────────────────────────────
# JWT secret for signing authentication tokens
# ⚠️  MUST CHANGE IN PRODUCTION — Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-in-production-12345

# JWT access token lifetime (hours)
ACCESS_TTL_HOURS=24

# Admin seeding password (for local testing only)
ADMIN_PASSWORD=admin2026

# ── PASSWORD HASHING ──────────────────────────────────────────────────────────
# Set to 1 on Windows if bcrypt compatibility issues occur
# Fallback to SHA-256 HMAC when set to 1
FORCE_SIMPLE_HASH=0

# ── CORS CONFIGURATION ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# For development: http://localhost:5173 (Vite dev server)
# For production: https://yourdomain.com
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# ── LLM INTEGRATION (AI Chat) ─────────────────────────────────────────────────
# Provider: g4f (free), huggingface, custom
LLM_PROVIDER=g4f
LLM_MODEL=openai-large
LLM_API_BASE_URL=http://localhost:1337/v1
LLM_API_KEY=

# Optional: enable deterministic rules fallback when LLM fails
AI_ENABLE_RULE_FALLBACK=1

# Optional: path to gpt4free repo if auto-detect fails
# G4F_REPO_PATH=../gpt4free-main

# ── OPTIONAL: CUSTOM LLM ENDPOINT ─────────────────────────────────────────────
# Uncomment to use custom LLM server instead of g4f
# LLM_PROVIDER=custom
# LLM_CUSTOM_URL=http://localhost:9000/v1/chat/completions
# LLM_CUSTOM_AUTH_HEADER=Authorization
# LLM_CUSTOM_AUTH_VALUE=Bearer <your-api-key>

# ── OPTIONAL: HUGGINGFACE ─────────────────────────────────────────────────────
# Uncomment to use HuggingFace Inference API
# LLM_PROVIDER=huggingface
# HF_API_KEY=hf_xxxxxxxxxxxxxxxx
# HF_MODEL=google/flan-t5-base
